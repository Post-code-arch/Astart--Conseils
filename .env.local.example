# Sanity — copier vers .env.local et remplir, puis renseigner les mêmes
# variables dans Vercel (Project → Settings → Environment Variables).

# Public (lecture) — non secrètes
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Secret — UNIQUEMENT pour le seed local (ne pas mettre dans Vercel public).
# Token rôle "Editor" créé dans Sanity (Settings → API → Tokens).
SANITY_WRITE_TOKEN=
