# Sanity — copier vers .env.local et remplir, puis renseigner les mêmes
# variables dans Vercel (Project → Settings → Environment Variables).

# Public (lecture) — non secrètes
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Secret — token rôle "Editor" créé dans Sanity (Settings → API → Tokens).
# Sert au seed ET à l'admin cliente (écritures côté serveur). NE PAS préfixer NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=

# Secret — mot de passe partagé unique pour se connecter à /admin (2 utilisatrices).
# Sert aussi de clé de signature du cookie de session admin.
ADMIN_PASSWORD=
